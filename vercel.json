{
  "version": 2,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "telanganalive.in" }],
      "destination": "https://www.telangana.live/$1",
      "statusCode": 308
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.telanganalive.in" }],
      "destination": "https://www.telangana.live/$1",
      "statusCode": 308
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "telanganalive.online" }],
      "destination": "https://www.telangana.live/$1",
      "statusCode": 308
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "telanganalive.shop" }],
      "destination": "https://www.telangana.live/$1",
      "statusCode": 308
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.telanganalive.shop" }],
      "destination": "https://www.telangana.live/$1",
      "statusCode": 308
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/:path*", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/ads.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
