# =============================================================
# SUPABASE (Required for live data: emergency status, reports, power alerts)
# Create a project at https://supabase.com and copy the values from
# Project Settings → API
# =============================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# OpenWeatherMap API Key
# Sign up at https://openweathermap.org/api and paste your key below.
# The free tier (1000 calls/day) is more than enough for this portal.
# If left empty, the app will use mock data automatically.
VITE_OWM_API_KEY=

# OWM_API_KEY is used by the server-side weather_scraper.py (same key as above).
OWM_API_KEY=


# =============================================================
# UPSTASH REDIS (Free tier: https://upstash.com)
# Used by /api/power-alerts.js to read n8n-scraped data
# Create a database -> copy REST URL and Token
# =============================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# =============================================================
# NOTION INTEGRATION (Optional - for n8n to write power cuts)
# Create integration at https://www.notion.so/my-integrations
# Copy the Internal Integration Secret below
# =============================================================
NOTION_API_KEY=
NOTION_POWER_CUTS_DB_ID=

# =============================================================
# VERCEL ENVIRONMENT (auto-set by Vercel, no action needed)
# Used to determine if running in production vs local
# =============================================================
VERCEL_ENV=development

# =============================================================
# LOCAL DEV ONLY - Base URL for API calls
# In production (Vercel), leave empty - APIs are at /api/*
# In local dev, set to empty string (Vite proxy handles it)
# =============================================================
VITE_API_BASE=
